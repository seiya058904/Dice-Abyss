+// Reuse identical vertices without changing any triangle, normal, UV, face or
+// shader. Keeping the original tessellation also preserves its interpolation.
+export function indexedRoundedCubeMesh(steps=12,radius=.075){
+  const expanded=roundedCubeMesh(steps,radius),vertices=[],lookup=new Map();
+  const indices=new Uint16Array(expanded.length/9);
+  for(let offset=0;offset<expanded.length;offset+=9){
+    const vertex=expanded.subarray(offset,offset+9),key=vertex.join(',');
+    let index=lookup.get(key);
+    if(index===undefined){
+      index=vertices.length/9;
+      if(index>65535)throw new RangeError('Dice mesh exceeds 16-bit indices');
+      lookup.set(key,index);vertices.push(...vertex);
+    }
+    indices[offset/9]=index;
+  }
+  return {vertices:new Float32Array(vertices),indices};
 }
