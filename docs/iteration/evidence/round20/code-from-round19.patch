+  if(!choice)return null;
+  const odds=diceOdds(s),faces=[...odds.faces];
+  if(!integer(odds.luck,0,200)||faces.length!==6||!faces.every(n=>Number.isFinite(n)&&n>=0&&n<=1)||Math.abs(faces.reduce((a,b)=>a+b,0)-1)>1e-10)return null;
